
# Frontend (Vite) — safe to expose in the browser bundle
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Supabase Edge Function secrets — set with:
#   supabase secrets set --env-file supabase/.env
# NEVER expose these in the frontend bundle.
# NOTE: do NOT add SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY / SUPABASE_ANON_KEY
# here — Supabase auto-injects these into every Edge Function at runtime, and
# `supabase secrets set` rejects any custom variable starting with SUPABASE_.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
REMINDER_FROM_EMAIL=reminders@yourdomain.com
APP_URL=https://your-app-domain.com
# Shared secret the daily cron job must send as the `x-cron-secret` header
# when it calls send-reminders. Generate with: openssl rand -hex 32
CRON_SECRET=

